#!/bin/bash
# Show status of all autotunnel@ instances (enabled/disabled, running/stopped).
set -u

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autotunnel"

if [[ -t 1 ]]; then
    G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' N=$'\e[0m'
else
    G='' R='' Y='' N=''
fi

color() {
    case "$1" in
        enabled|active) printf '%s%-9s%s' "$G" "$1" "$N" ;;
        activating|reloading|deactivating|enabled-runtime|static|indirect) printf '%s%-9s%s' "$Y" "$1" "$N" ;;
        *) printf '%s%-9s%s' "$R" "$1" "$N" ;;
    esac
}

# instance names: from config files + any loaded/enabled units
declare -A seen=()
shopt -s nullglob
for f in "$CONF_DIR"/*.conf; do
    n=${f##*/}; seen[${n%.conf}]=1
done
while read -r unit _; do
    [[ $unit == autotunnel@*.service ]] || continue
    n=${unit#autotunnel@}; seen[${n%.service}]=1
done < <(systemctl --user list-units --all --plain --no-legend 'autotunnel@*' 2>/dev/null)
for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/systemd/user/*.wants/autotunnel@*.service; do
    n=${f##*/autotunnel@}; seen[${n%.service}]=1
done

if (( ${#seen[@]} == 0 )); then
    echo "no tunnels configured in $CONF_DIR" >&2
    exit 1
fi

printf '%-16s %-22s %-28s %-9s %-9s\n' NAME LISTEN DEST ENABLED ACTIVE
mapfile -t names < <(printf '%s\n' "${!seen[@]}" | sort)
for name in "${names[@]}"; do
    unit="autotunnel@${name}.service"
    listen='-' dest='-'
    conf="$CONF_DIR/$name.conf"
    if [[ -r $conf ]]; then
        listen=$(sed -n 's/^[[:space:]]*LISTEN=//p' "$conf" | tail -n1 | tr -d "\"'")
        dest=$(sed -n 's/^[[:space:]]*DEST=//p' "$conf" | tail -n1 | tr -d "\"'")
    else
        dest="${R}(conf missing)${N}"
    fi
    enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null); enabled=${enabled:-disabled}
    active=$(systemctl --user is-active "$unit" 2>/dev/null); active=${active:-inactive}
    printf '%-16s %-22s %-28s %s %s\n' "$name" "${listen:--}" "${dest:--}" "$(color "$enabled")" "$(color "$active")"
done
